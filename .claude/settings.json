{
  "permissions": {
    "allow": [
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin feat/app-foundation:main:*)",
      "Bash(git merge --ff-only origin/main:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main --force:*)",
      "Bash(git push origin main -f:*)"
    ]
  }
}
