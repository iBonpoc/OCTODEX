// Cloudflare Workers (static assets): serves the Expo web build of apps/mobile.
// Build command in Cloudflare: cd apps/mobile && npx expo export --platform web
// Deploy command: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "octodex",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./apps/mobile/dist",
    "not_found_handling": "single-page-application"
  }
}
